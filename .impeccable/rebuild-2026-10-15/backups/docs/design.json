  "narrative": {
    "northStar": "The Quiet Ritual",
    "overview": "The site is a small, unhurried daily ceremony made visible. There are four formulas and nothing extra, and every element earns its place by helping her want, understand or buy one of them. The homepage is light from top to bottom: the hero is the 24h Regeneration Cream on pearl silk, the Collection sits on gallery white, and each story section is a full-bleed photograph with its type set on the image (the caviar macro, the clinical portrait, the Matterhorn in cloud). Darkness is kept for the footer. Type pairs a fine high-contrast serif for voice with a light sans for reading, and short spaced-caps labels for wayfinding.\n\nRestraint is the method. Elements are spaced generously and set in a narrow, near-achromatic palette; where a surface carries warmth, it is sampled from its own photograph so image and page read as one plane. The ornaments are photographs of the real objects and textures: chrome caps, pearl silk, backlit caviar pearls, a hand holding each formula. Precision shows in the details: lining numerals, hairline rules, every clinical figure named with its product, method and panel. Copy moves her before it informs her; certificates and methods live one click deeper.",
    "keyCharacteristics": [
      "Light everywhere: pearl canvas (#F2F2EF), gallery white for products, photo-matched warm tones for photographic sections; dark only in the footer.",
      "Type on the photograph: story sections set label, heading and lede directly on the image's calm side.",
      "Cormorant Garamond 300 for voice, Inter 300/400 for reading, Inter 500 tracked caps for short labels.",
      "Square corners, hairline rules, no shadows; feathered masks instead of frames where a photograph meets the page.",
      "Real, label-accurate photography as the primary ornament; the ritual numerals 1–4 as the closing section's spine."
    ],
    "rules": [
      {
        "name": "The Sampled Warmth Rule",
        "body": "No hue is chosen for the UI. A section may take a warm tone only when it is sampled from (or retouched into) its own photograph, so the image and the surface meet without a seam.",
        "section": "colors"
      },
      {
        "name": "The Punctuation Rule",
        "body": "Dark surfaces appear only in the footer and behind photography. A text-only section is never dark.",
        "section": "colors"
      },
      {
        "name": "The One Red Rule",
        "body": "Swiss red belongs to the logo's cross. It never colours a button, link, badge or price.",
        "section": "colors"
      },
      {
        "name": "The Short Caps Rule",
        "body": "Spaced caps are only for labels of four words or fewer. Anything longer is sentence case.",
        "section": "typography"
      },
      {
        "name": "The Lining Numeral Rule",
        "body": "Any numeral set in Cormorant (figures, step numbers, \"24h\") uses lining numerals; old-style figures read as \"o1\".",
        "section": "typography"
      },
      {
        "name": "The Reading Floor Rule",
        "body": "Nothing she has to read is under 16px. Purchase details and actions sit at 15px; only labels and tertiary notes go smaller.",
        "section": "typography"
      },
      {
        "name": "The First Screen Rule",
        "body": "On a 390×844 iPhone, the hero headline and its one action sit in the first screen, with the product photograph beginning below them.",
        "section": "layout"
      },
      {
        "name": "The Flat Surface Rule",
        "body": "If something needs separating, use space first, a hairline second, and a tone change third. Never a shadow.",
        "section": "elevation"
      },
      {
        "name": "The No Frame Rule",
        "body": "A photograph never sits in a visible box on the page: match its backdrop, extend it, or feather it.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do keep every section light; set type on the calm side of a photograph rather than in a separate band.",
      "Do sample any warm surface tone from its own photograph, and keep the Collection on white.",
      "Do name every clinical figure with its product, method and panel, and keep self-reported results visibly secondary and unpinned.",
      "Do keep tap targets at 44px or more and reading copy at 16px or more.",
      "Do use lining numerals for any Cormorant numeral.",
      "Do photograph the real packaging with accurate labels; product imagery is the ornament.",
      "Do lead with feeling on the homepage; certificates, methods and standards live on the science pages."
    ],
    "donts": [
      "Don't add shadows, rounded corners or gradient fills to UI elements.",
      "Don't let a photograph show a frame or seam against the page.",
      "Don't use Swiss red anywhere except the logo.",
      "Don't set long phrases in spaced caps.",
      "Don't add star ratings, testimonials or press logos.",
      "Don't echo cobalt blue with caviar (another house's signature)."
    ]
  }
}